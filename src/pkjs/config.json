[
  {
    "type": "heading",
    "defaultValue": "Your Style Configuration"
  },
  {
    "type": "text",
    "defaultValue": "Configure the Your Style Watchface."
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Presets",
        "id": "heading-presets"
      },
      {
        "type": "text",
        "defaultValue": "Store up to 5 complete configurations. <em>Load</em> fills the page with the stored values; <em>Save to Slot</em> stores what the page currently shows. Both only become permanent when you press <em>Save Settings</em> at the bottom.",
        "group": "presets"
      },
      {
        "type": "select",
        "id": "preset-slot",
        "label": "Slot",
        "defaultValue": "0",
        "options": [
          { "label": "1: —", "value": "0" },
          { "label": "2: —", "value": "1" },
          { "label": "3: —", "value": "2" },
          { "label": "4: —", "value": "3" },
          { "label": "5: —", "value": "4" }
        ],
        "group": "presets"
      },
      {
        "type": "input",
        "id": "preset-name",
        "label": "Name",
        "defaultValue": "",
        "attributes": { "placeholder": "Preset name" },
        "group": "presets"
      },
      {
        "type": "button",
        "id": "preset-save",
        "defaultValue": "Save current settings to slot",
        "group": "presets"
      },
      {
        "type": "button",
        "id": "preset-load",
        "defaultValue": "Load slot into page",
        "primary": true,
        "group": "presets"
      },
      {
        "type": "text",
        "defaultValue": "<p style='color:lightblue'>PRESET CODE</p>",
        "group": "presets"
      },
      {
        "type": "text",
        "defaultValue": "A code holds a complete configuration as text. Copy it somewhere safe and you can paste it back after a reinstall, on another phone, or send it to someone else. Codes only store what you changed, so a lightly tweaked setup gives a shorter code than a heavily rebuilt one.",
        "group": "presets"
      },
      {
        "type": "input",
        "id": "preset-code",
        "label": "Code",
        "defaultValue": "",
        "attributes": { "placeholder": "YS-XXXXX-XXXXX-..." },
        "group": "presets"
      },
      {
        "type": "button",
        "id": "preset-code-gen",
        "defaultValue": "Show code for current settings",
        "group": "presets"
      },
      {
        "type": "button",
        "id": "preset-code-apply",
        "defaultValue": "Apply code from the field",
        "group": "presets"
      },
      {
        "type": "input",
        "id": "preset-blob",
        "messageKey": "presetblob",
        "label": "",
        "defaultValue": "",
        "group": "presets"
      }
    ]
  },
  {
